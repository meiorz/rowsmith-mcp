{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.meiorz/rowsmith",
  "title": "Rowsmith test data",
  "description": "Fake test data (CSV, JSON, SQL) from a schema. Reserved-range identifiers; reproducible by seed.",
  "repository": {
    "url": "https://github.com/meiorz/rowsmith-mcp",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "rowsmith-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ROWSMITH_URL",
          "description": "Override the API base URL (default https://testdata-api.re-jam620.workers.dev)",
          "isRequired": false
        }
      ]
    }
  ]
}
